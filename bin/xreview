#!/bin/sh
# Launcher for the xreview runner. It runs the first Python >= 3.10 it finds:
# uv's choice if uv is installed, else python3 or python3.N on PATH (system,
# Homebrew, conda, pyenv, ...). The interpreter is run directly, not through
# `uv run`, so the environment Codex inherits is unchanged. -I keeps files in
# the target repo from shadowing the standard library.
root=$(cd "${0%/*}/.." && pwd -P)
for py in "$(uv python find --system '>=3.10' 2>/dev/null)" \
          python3 python3.14 python3.13 python3.12 python3.11 python3.10; do
  if [ -n "$py" ] && "$py" -c 'import sys; sys.exit(sys.version_info < (3, 10))' 2>/dev/null; then
    exec "$py" -I -c 'import sys; sys.path.insert(0, sys.argv.pop(1)); from xreview.cli import main; sys.exit(main())' "$root" "$@"
  fi
done
echo "xreview: needs Python 3.10 or later; none found via uv or on PATH" >&2
exit 1
